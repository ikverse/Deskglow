<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing to configure and nothing to refresh: the widget is only a button. It resizes from 1x1
     up to large; the provider picks the layout that fits the current size. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/start_widget"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="320dp"
    android:previewLayout="@layout/start_widget_large"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
