<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Deskglow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The display itself: pure black from the very first frame, no bars. -->
    <style name="Theme.Deskglow.Display" parent="Theme.Deskglow">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
